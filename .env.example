# Server Configuration
PROJECT_NAME="AI-Powered Smart Business Operations & Decision Intelligence System"
VERSION="2.0.0"
API_V1_STR="/api"

# JWT Secret Key
SECRET_KEY="replace-with-a-secure-random-jwt-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (SQLite by default, or PostgreSQL / MySQL)
DATABASE_URL="sqlite:///./data/banking_intelligence.db"
# DATABASE_URL="postgresql://postgres:password@localhost:5432/banking_intelligence"
# DATABASE_URL="mysql+pymysql://root:password@localhost:3306/banking_intelligence"

# LLM Providers (Optional - Analytical Grounded Fallback operates with 100% accuracy without keys)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
LLM_MODEL="gemini-2.0-flash"
LLM_TEMPERATURE=0.2
